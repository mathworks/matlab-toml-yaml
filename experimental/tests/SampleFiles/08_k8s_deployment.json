{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "acme-web",
    "labels": {
      "app": "acme-web"
    }
  },
  "spec": {
    "replicas": 3,
    "selector": {
      "matchLabels": {
        "app": "acme-web"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "acme-web"
        }
      },
      "spec": {
        "containers": [
          {
            "name": "web",
            "image": "ghcr.io/acme/web:1.0.0",
            "ports": [
              {
                "containerPort": 3000
              }
            ],
            "env": [
              {
                "name": "NODE_ENV",
                "value": "production"
              },
              {
                "name": "API_BASE_URL",
                "value": "https://api.acme-payments.example"
              }
            ],
            "resources": {
              "requests": {
                "cpu": "100m",
                "memory": "128Mi"
              },
              "limits": {
                "cpu": "500m",
                "memory": "512Mi"
              }
            },
            "livenessProbe": {
              "httpGet": {
                "path": "/health",
                "port": 3000
              },
              "initialDelaySeconds": 10,
              "periodSeconds": 15
            }
          }
        ]
      }
    }
  }
}