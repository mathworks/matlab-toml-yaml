{
  "schemaVersion": "1.1.0",
  "name": "Example Extension Registry",
  "extensions": [
    {
      "id": "com.acme.formatter",
      "displayName": "Code Formatter",
      "version": "0.4.2",
      "entry": "./formatter/main.m",
      "activation": [
        "onCommand:formatDocument",
        "onLanguage:MATLAB"
      ],
      "contributes": {
        "commands": [
          {
            "id": "formatDocument",
            "title": "Format Document"
          }
        ],
        "configuration": {
          "properties": {
            "formatter.indentSize": {
              "type": "integer",
              "default": 4,
              "minimum": 0,
              "maximum": 8
            },
            "formatter.lineWidth": {
              "type": "integer",
              "default": 100
            }
          }
        }
      }
    }
  ]
}