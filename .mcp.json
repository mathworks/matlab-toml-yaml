{
  "mcpServers": {
    "matlab": {
      "type": "stdio",
      "command": "/Applications/MCP Servers/matlab-mcp-core-server",
      "args": [
        "--matlab-root",
        "/Applications/MATLABR2026aPrerelease/MATLAB_R2026a.app",
        "--matlab-display-mode",
        "nodesktop"
      ],
      "env": {}
    },
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "${PROJECT_ROOT:-.}"
      ],
      "env": {}
    }
  }
}
